<!DOCTYPE html>
<html lang="en">
<head>
  <title>Contact Form — LifeLine</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body { font-family: Arial, Helvetica, sans-serif; background-color: #f4f6f8; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .header { background: linear-gradient(135deg, #1558c0 0%, #1d6fe8 60%, #4285f4 100%); color: #ffffff; padding: 28px 30px; text-align: center; }
    .header h2 { margin: 0; font-size: 20px; }
    .header p { margin: 6px 0 0; opacity: 0.85; font-size: 13px; }
    .content { padding: 30px; color: #333333; line-height: 1.6; }
    .field { background: #f5f7fb; border-radius: 8px; padding: 14px 18px; margin-bottom: 14px; }
    .field-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; margin-bottom: 4px; }
    .field-value { font-size: 14px; color: #0f1729; }
    .message-box { background: #f0f4ff; border-left: 3px solid #1d6fe8; border-radius: 0 8px 8px 0; padding: 16px 18px; margin-top: 6px; }
    .footer { background-color: #f9fafb; padding: 15px; text-align: center; font-size: 13px; color: #777777; }
    a { color: #1d6fe8; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>📩 New Contact Message — LifeLine</h2>
      <p>Someone has sent a message through the contact form</p>
    </div>
    <div class="content">
      <div class="field">
        <div class="field-label">Name</div>
        <div class="field-value"><%= name %></div>
      </div>
      <div class="field">
        <div class="field-label">Email</div>
        <div class="field-value"><a href="mailto:<%= email %>"><%= email %></a></div>
      </div>
      <div class="field">
        <div class="field-label">Subject</div>
        <div class="field-value"><%= subject %></div>
      </div>
      <div class="field">
        <div class="field-label">Message</div>
        <div class="message-box"><%= message %></div>
      </div>
    </div>
    <div class="footer">
      <p>© <%= new Date().getFullYear() %> LifeLine Medical Platform. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
