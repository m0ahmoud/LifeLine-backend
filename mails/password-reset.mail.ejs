<!DOCTYPE html>
<html lang="<%= isArabic ? 'ar' : 'en' %>" dir="<%= isArabic ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= isArabic ? "إعادة تعيين كلمة المرور" : "Reset Your Password" %></title>
</head>
<body style="margin:0; padding:0; background-color:#f5f7fb; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f7fb; padding: 32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width:480px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 14px rgba(29,111,232,0.08);">

          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #1558c0 0%, #1d6fe8 50%, #4285f4 100%); padding: 32px 40px; text-align:center;">
              <div style="display:inline-flex; align-items:center; gap:10px;">
                <span style="font-size:28px; line-height:1;">💙</span>
                <span style="color:#ffffff; font-size:22px; font-weight:bold; letter-spacing:-0.3px;">LifeLine</span>
              </div>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px 40px 24px 40px;">
              <h2 style="margin:0 0 16px 0; font-size:22px; color:#0f1729; font-weight:bold;">
                <% if (isArabic) { %>
                  مرحباً <%= user.name %>،
                <% } else { %>
                  Hi <%= user.name %>,
                <% } %>
              </h2>

              <p style="margin:0 0 12px 0; font-size:14.5px; line-height:1.7; color:#475569;">
                <% if (isArabic) { %>
                  وصلنا طلب لإعادة تعيين كلمة المرور الخاصة بحسابك على LifeLine. اضغط على الزر أدناه لإنشاء كلمة مرور جديدة.
                <% } else { %>
                  We received a request to reset the password for your LifeLine account. Click the button below to create a new password.
                <% } %>
              </p>

              <p style="margin:0 0 28px 0; font-size:13.5px; line-height:1.6; color:#94a3b8;">
                <% if (isArabic) { %>
                  هذا الرابط صالح لمدة 15 دقيقة فقط.
                <% } else { %>
                  This link is valid for 15 minutes only.
                <% } %>
              </p>

              <!-- Button -->
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                <tr>
                  <td style="border-radius:10px; background: linear-gradient(135deg, #1558c0 0%, #1d6fe8 100%);">
                    <a href="<%= resetUrl %>"
                       style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
                      <%= isArabic ? "إعادة تعيين كلمة المرور" : "Reset Password" %>
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin: 28px 0 0 0; font-size:12.5px; line-height:1.6; color:#94a3b8;">
                <% if (isArabic) { %>
                  إذا لم يعمل الزر، انسخ الرابط التالي والصقه في المتصفح:
                <% } else { %>
                  If the button doesn't work, copy and paste this link into your browser:
                <% } %>
              </p>
              <p style="margin: 6px 0 0 0; font-size:12.5px; word-break:break-all;">
                <a href="<%= resetUrl %>" style="color:#1d6fe8; text-decoration:underline;"><%= resetUrl %></a>
              </p>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 0 40px;">
              <div style="height:1px; background-color:#e2e8f0;"></div>
            </td>
          </tr>

          <!-- Security note -->
          <tr>
            <td style="padding: 24px 40px 32px 40px;">
              <p style="margin:0; font-size:12.5px; line-height:1.7; color:#94a3b8;">
                <% if (isArabic) { %>
                  إذا لم تطلب إعادة تعيين كلمة المرور، يمكنك تجاهل هذا البريد الإلكتروني بأمان. لن يتم تغيير كلمة المرور الخاصة بك.
                <% } else { %>
                  If you didn't request a password reset, you can safely ignore this email. Your password will not be changed.
                <% } %>
              </p>
            </td>
          </tr>
        </table>

        <!-- Footer -->
        <table role="presentation" width="100%" style="max-width:480px; margin-top:20px;">
          <tr>
            <td align="center">
              <p style="margin:0; font-size:12px; color:#94a3b8;">
                &copy; <%= new Date().getFullYear() %> LifeLine.
                <% if (isArabic) { %>
                  جميع الحقوق محفوظة.
                <% } else { %>
                  All rights reserved.
                <% } %>
              </p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>